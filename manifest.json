{
  "manifest_version": 3,
  "name": "MCQ Solver",
  "version": "2.0.0",
  "description": "Automatically identifies and highlights correct MCQ answers using AI.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.amazonaws.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
